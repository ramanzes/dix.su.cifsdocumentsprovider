    <string name="edit_backup_section_title">Бэкап</string>
    <string name="edit_backup_hint">Загружает новые файлы (сверка по имени и размеру) из локальной папки в корень этого соединения. «Бэкап» — по нажатию; «Автобэкап» ниже — периодически в фоне.</string>
    <string name="edit_backup_select_folder">Выбрать папку для бэкапа</string>
